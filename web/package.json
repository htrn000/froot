{
  "name": "fruitbox-web",
  "version": "1.0.0",
  "private": true,
  "description": "Fruitbox PWA frontend.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:wasm": "wasm-pack build ../wasm/fruitbox_wasm --target web --out-dir ../../web/src/wasm --no-pack && rm -f src/wasm/.gitignore",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
